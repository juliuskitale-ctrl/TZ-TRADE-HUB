# Copy to .env for local development.
# NEVER put real credentials in this file or commit .env.

APP_NAME=TZ Trade Hub
NODE_ENV=development
PORT=3000

CLICKPESA_CLIENT_ID=your_clickpesa_client_id_here
CLICKPESA_API_KEY=your_clickpesa_api_key_here
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

# Public HTTPS URL of this app in production.
# Example: https://tz-trade-hub.onrender.com
APP_BASE_URL=http://localhost:3000
